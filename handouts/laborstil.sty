% Zeilenabstand und Absaetze
\setstretch{1.12}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em plus 0.1em}
\setlist{itemsep=0.15em, topsep=0.25em, parsep=0pt}
\setlist[enumerate,1]{label=\alph*)}
\renewcommand{\arraystretch}{1.25}
\urlstyle{same}
\setlength{\emergencystretch}{2em}

% Kopf- und Fusszeile wie im Referenzheft: Abschnitt rechts, Unterabschnitt links, Linie unter dem Kopf
\newcommand{\fusstext}{}
\newcommand{\fusszeile}[1]{\renewcommand{\fusstext}{#1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\sectionmark}[1]{\markboth{\MakeUppercase{\thesection\quad #1}}{}}
\renewcommand{\subsectionmark}[1]{\markright{\thesubsection\quad #1}}
\fancyhead[R]{\small\slshape\leftmark}
\fancyhead[L]{\small\slshape\rightmark}
\fancyfoot[L]{\small\fusstext}
\fancyfoot[R]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}

% Titelseite: Titel, Versuch, Modul, leere Felder fuer Name und Matrikelnummer (keine Autorenzeile)
\newcommand{\titelseite}[3]{%
  \thispagestyle{plain}
  \begin{center}
    \vspace*{1.8cm}
    {\LARGE\bfseries\setstretch{1.35} #1\par}
    \vspace{0.8cm}
    {\Large\bfseries #2\par}
    \vspace{1.6cm}
    {\large Digitale Audiosignalverarbeitung\par}
    \vspace{0.3cm}
    {Begleitheft zum Jupyter-Notebook \texttt{#3}\par}
  \end{center}
  \vfill
  \begin{center}
    \begin{tabular}{|p{6.2cm}|p{3.6cm}|p{3.6cm}|}
      \hline
      \small Name, Vorname & \small Matrikelnummer & \small Gruppe \\
      \hline
      \rule{0pt}{1.25cm} & & \\ \hline
      \rule{0pt}{1.25cm} & & \\ \hline
      \rule{0pt}{1.25cm} & & \\ \hline
    \end{tabular}
  \end{center}
  \vspace*{1.5cm}
  \clearpage
}

% Aufgabenkennzeichnung
\newcommand{\aufgabe}[2]{\par\smallskip\noindent\textbf{Aufgabe #1} \textnormal{(#2)}\par\nobreak}
\newcommand{\zusatz}[1]{\par\smallskip\noindent\textbf{Zusatzaufgabe #1} \textnormal{(optional)}\par\nobreak}
\newcommand{\uebung}[1]{\textbf{Übung #1}}
\newcommand{\param}[1]{\texttt{#1}}
\newcommand{\ziel}[1]{\par\noindent\textbf{Ziel:} #1\par}

% Antwortlinien: #1 = Anzahl
\newcommand{\antwortlinien}[1]{%
  \par\vspace{0.1cm}%
  \begingroup\count255=#1\relax
  \loop\ifnum\count255>0
    \vspace{0.52cm}\noindent\rule{\linewidth}{0.3pt}\par
    \advance\count255 by -1
  \repeat\endgroup\par\smallskip}

% Block, der nicht ueber eine Seitengrenze getrennt wird (Aufgabe mit Antwortlinien)
\newenvironment{block}{\par\smallskip\noindent\begin{minipage}{\linewidth}\setlength{\parskip}{0.45em plus 0.1em}}{\end{minipage}\par\smallskip}

% Titel einer Ergebnistabelle
\newcommand{\tabtitel}[1]{\par\medskip\noindent\textbf{#1}\par\nobreak\smallskip}

% Leere Tabellenzeile mit Schreibhoehe
\newcommand{\schreibzeile}{\rule{0pt}{0.75cm}}

% Kasten mit QR-Code und Link zum Notebook: #1 QR-Datei, #2 URL, #3 und #4 die zwei angezeigten Zeilen
\newcommand{\notebooklink}[4]{%
  \par\medskip\noindent
  \begin{minipage}[c]{3.1cm}\includegraphics[width=2.9cm]{#1}\end{minipage}\hfill
  \begin{minipage}[c]{\dimexpr\linewidth-3.5cm\relax}
    \textbf{Notebook in Google Colab öffnen:}\\[0.15cm]
    \footnotesize\href{#2}{#3}\\\href{#2}{#4}
  \end{minipage}\par\medskip}

% Spaltentypen mit Flattersatz (Kopfzeilen koennen umbrechen)
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}

% Frage mit Antwortlinien in einer Aufzaehlung (Nummer oben ausgerichtet, nicht ueber Seiten getrennt)
\newcommand{\frage}[2]{\item\begin{minipage}[t]{\linewidth}#1\antwortlinien{#2}\end{minipage}}

% PDF-Metadaten ohne Author-Eintrag schreiben (hyperref schreibt sonst ein leeres Author-Feld)
\AtBeginDocument{%
  \ifdefined\PDF@FinishDoc
  \def\PDF@FinishDoc{%
    \pdf@ifdraftmode{}{%
      \Hy@UseMaketitleInfos
      \HyInfo@GenerateAddons
      \pdfinfo{%
        /Title(\@pdftitle)%
        /Subject(\@pdfsubject)%
        /Creator(\@pdfcreator)%
        \ifx\@pdfproducer\relax\else/Producer(\@pdfproducer)\fi
        /Keywords(\@pdfkeywords)%
        \HyInfo@Addons
      }%
    }%
  }%
  \fi
}

\endinput
